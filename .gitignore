# Gradle files
.gradle/
build/
# buildSrc has a Kotlin package named "build" — explicitly un-ignore those sources.
!buildSrc/src/main/kotlin/dev/hossain/highlight/build/
!buildSrc/src/main/kotlin/dev/hossain/highlight/build/**

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Playwright Agent CLI session artifacts (browser snapshots, screenshots, console logs)
.playwright-cli/

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# Allow the debug keystore used for signing sample release builds in CI
!keystore/debug.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof
.DS_Store

# Generated API documentation (built by Dokka, included in Zensical site build)
docs/api/
resources/api/

# Zensical docs build output
site/
.cache/
gradle/gradle-daemon-jvm.properties
*.salive
build_log.txt
skills/
